# Copy to backend/.env on VPS — fill ALL values, no defaults for secrets
SECRET_KEY=replace-with-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=api.yourdomain.com,vision-bice-sigma.vercel.app
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://vision-bice-sigma.vercel.app,https://vision.example.com

# Postgres — must match docker-compose.prod.yml db service
DB_NAME=vision_db
DB_USER=vision_user
DB_PASSWORD=STRONG_RANDOM_PASSWORD_HERE
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379

# Ollama — inside compose network
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_TEXT_MODEL=llama3
OLLAMA_VISION_MODEL=moondream
OLLAMA_VISION_ENABLED=True
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
