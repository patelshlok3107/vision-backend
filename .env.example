# VISION Environment — copy to .env and configure
# Ollama must be running locally. No external API required.

OLLAMA_BASE_URL=http://localhost:11434
# Text model — must be installed: ollama pull llama3
OLLAMA_TEXT_MODEL=llama3
# Vision model — must support image input. Examples: llava, moondream, bakllava, llava-phi3
# Leave empty to disable vision: OLLAMA_VISION_MODEL=
OLLAMA_VISION_MODEL=moondream
OLLAMA_TEXT_TIMEOUT=30000
OLLAMA_VISION_TIMEOUT=120000
OLLAMA_VISION_ENABLED=True

OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIM=768

# Attachments
VISION_MAX_IMAGES_PER_MESSAGE=5
VISION_MAX_IMAGE_SIZE_MB=10
VISION_MAX_IMAGE_DIMENSION=2048
